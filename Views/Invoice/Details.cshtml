@model invoiceApp.Models.Invoice
@using System.Globalization
<div class="no-print d-flex justify-content-center gap-2 mb-4">
    <button onclick="window.print()" class="btn btn-primary btn-lg">
        <i class="bi bi-printer me-1"></i>Print Invoice
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>
<div class="invoice-box">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <span class="invoice-title">INVOICE</span>
        </div>
        <div class="text-end">
            <table class="table table-borderless table-sm mb-0" style="width: auto;">
                <tr>
                    <td class="fw-bold text-end pe-3">Invoice #:</td>
                    <td>@Model.Id</td>
                </tr>
                <tr>
                    <td class="fw-bold text-end pe-3">Date:</td>
                    <td>@Model.Date.ToString("MMMM dd, yyyy", CultureInfo.InvariantCulture)</td>
                </tr>
            </table>
        </div>
    </div>
    <!-- Bill To -->
    <div class="bill-to-section mb-4">
        <h6 class="text-muted text-uppercase mb-2" style="letter-spacing:1px;">Bill To</h6>
        <h4 class="fw-bold mb-2">@Model.Customer?.Name</h4>
        <p class="mb-1 text-muted">
            <i class="bi bi-geo-alt-fill me-1"></i>@Model.Customer?.Address
        </p>
        <p class="mb-0 text-muted">
            <i class="bi bi-telephone-fill me-1"></i>@Model.Customer?.Phone
        </p>
    </div>
    <!-- Items Table -->
    <table class="table table-bordered align-middle">
        <thead>
            <tr class="table-dark">
                <th style="width:60px" class="text-center">#</th>
                <th>Item</th>
                <th>Description</th>
                <th class="text-center" style="width:100px">Qty</th>
                <th class="text-end" style="width:120px">Price</th>
                <th class="text-end" style="width:130px">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @{ int itemNumber = 1; }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="text-center">@itemNumber</td>
                    <td><strong>@item.ItemName</strong></td>
                    <td class="text-muted">@item.Description</td>
                    <td class="text-center">@item.Amount</td>
                    <td class="text-end">@item.Price.ToString("C")</td>
                    <td class="text-end fw-bold">@((item.Price * item.Amount).ToString("C"))</td>
                </tr>
                itemNumber++;
            }
        </tbody>
        <tfoot>
            <tr class="total-row">
                <td colspan="5" class="text-end fw-bold fs-5 py-3">Total</td>
                <td class="text-end fw-bold fs-5 py-3">@Model.Total.ToString("C")</td>
            </tr>
        </tfoot>
    </table>
</div>