@model invoiceApp.Models.Customer

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Delete Customer</h4>
            </div>
            <div class="card-body">
                <p class="lead">Are you sure you want to delete this customer?</p>

                <table class="table table-borderless">
                    <tr>
                        <td class="fw-bold" style="width:120px">Name:</td>
                        <td>@Model.Name</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Phone:</td>
                        <td>@Model.Phone</td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Address:</td>
                        <td>@Model.Address</td>
                    </tr>
                </table>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Yes, Delete
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
